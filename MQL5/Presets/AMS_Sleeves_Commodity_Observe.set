; AdaptiveMultiStrategyEA - commodity CFD account, OBSERVATION ONLY (chapter 105). No orders are sent (InpIxDryRun=true).
; Logs the account and symbol conditions, the gold trend state, and exports daily bars of the commodity symbols for research.
; Run with the workflow input trading=false (the default of mt5-live-commodity.yml).
InpEntryMode=8
InpIxRevSymbols=none
InpIxTrendSymbols=XAUUSD
InpIxRuleR2=false
InpIxRuleD7=false
InpIxRuleIBS=false
InpIxRevUnitVol=0.0
InpIxTrendUnitVol=11.2
InpIxTrendCheckDays=7
InpIxMaxLev=10.0
InpIxBand=0.25
InpIxSLVolMul=4.0
InpIxVolModel=0
InpIxVixFile=none
InpIxVixLowMult=0.5
InpIxVixHighMult=1.5
InpIxRuleWeights=1,2,4
InpIxSoGuard=0.9
InpIxFlatMinutes=0
InpIxFlatEdgeBp=0.0
InpIxMaxSpreadPct=0.05
InpMaxMarginUsePct=90.0
InpIxDelayMin=0
InpIxJointRound=false
InpIxJointEps=0.25
InpIxWarmStart=true
InpIxRegimeDays=0
InpIxRegimeThr=1.0
InpIxRegimeRef=none
InpIxDryRun=true
InpIxEquityOffset=0
InpIxExportSymbols=XAUUSD,XAGUSD,COPPER,USOIL,UKOIL,NATGAS,CORN,SOYBEANS,SUGAR,WHEAT,US500,US100,JP225
