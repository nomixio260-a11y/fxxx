; AdaptiveMultiStrategyEA - recommended set (2026-11-18): rules based on specific days (gotobi, month-end/start, weekday) are stopped by the user's instruction
; Only A1 remains: EURUSD sell 11:00-12:59 London time on every weekday (a daily time-of-day pattern before the ECB reference rate), at 1.25x risk
; Attach to a USDJPY M5 chart (the EA trades EURUSD from it)
InpEntryMode=6
InpSymbols=EURUSD
InpTimeframe=5
InpCalendarRules=A1:EURUSD,LDN,1100,120,SELL,ALL,30,EXS:60
InpCalendarRules2=
InpCalendarRules3=
InpCalendarRules4=
InpRuleRiskMul=A1:1.25
InpEntryDelaySec=0
InpMonthTargetPct=0.0
InpMonthLockMul=0.5
InpAdaptWindow=100
InpAdaptMinTrades=60
InpAdaptMinPF=0.9
InpRiskPercent=5.0
InpMaxMarginUsePct=90.0
InpMinLevelAfterSL=110.0
InpMaxPositions=6
InpMaxPerSymbol=1
InpBETriggerATR=0.0
InpTrailDistATR=0.0
InpTPATR=0.0
InpMaxDDStopPct=0.0
InpDDRiskCutPct=25.0
InpDDRiskMul=0.5
InpSplitOrders=true
InpMaxLotsPerSymbol=30.0
InpAsyncOrders=true
InpLeadSec=-1
