; AdaptiveMultiStrategyEA - index sleeve, OBSERVATION ONLY (chapter 100). No orders are sent (InpIxDryRun=true).
; Used to compare the real account's conditions and the EA's decisions with the Strategy Tester.
; Run it with the workflow input trading=false, which also disables automated trading in the terminal itself.
InpEntryMode=8
InpIxRevSymbols=US500,US100,US30
InpIxTrendSymbols=none
InpIxRuleR2=true
InpIxRuleD7=true
InpIxRuleIBS=true
InpIxRevUnitVol=8.75
InpIxTrendUnitVol=0.0
InpIxTrendCheckDays=7
InpIxMaxLev=10.0
InpIxBand=0.25
InpIxSLVolMul=4.0
InpIxVolModel=1
InpIxVixFile=AMS_vix.csv
InpIxVixLowMult=0.5
InpIxVixHighMult=1.5
InpIxRuleWeights=1,2,4
InpIxSoGuard=0.9
InpIxFlatMinutes=0
InpIxFlatEdgeBp=0.0
InpIxMaxSpreadPct=0.05
InpMaxMarginUsePct=90.0
InpIxDelayMin=0
InpIxJointRound=false
InpIxJointEps=0.25
InpIxWarmStart=true
InpIxRegimeDays=1500
InpIxRegimeThr=1.0
InpIxRegimeRef=US500
InpIxDryRun=true
InpIxEquityOffset=0
; Probability sleeve (chapter 109), SHADOW: no orders. The EA writes the completed daily bars, tools/eco/predict.py turns them
; into probabilities (4 models averaged), and the EA logs what it would hold. The record is kept in reports/live_index/AMS_prob_log.csv.
InpPbSymbols=US500,US100,US30,JP225,GER30,UK100,FRA40,EU50,NL25,AUS200,HK50,CHINA50,SING30,US2000
InpPbFile=AMS_prob.csv
InpPbUnitVol=5.0
InpPbLongOnly=true
InpPbVolDays=20
InpPbSLVolMul=4.0
InpPbMaxLev=2.0
InpPbWaitMin=30
InpPbShadow=true
