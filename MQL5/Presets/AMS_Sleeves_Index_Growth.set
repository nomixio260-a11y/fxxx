; AdaptiveMultiStrategyEA - index account, LARGE setting (chapters 101, 103 and 104). HIGH RISK.
; Same two sleeves as AMS_Sleeves_Index_Demo.set at more than twice the size, whole balance (InpIxEquityOffset=0):
;   reversion on US500, US100, US30 and JP225 with InpIxRevUnitVol=8.75, trend on US100 with InpIxTrendUnitVol=20.
; Broker's own data, February 2020 - November 2026, 3,000,000 JPY (run 821): about +43% per year, maximum drawdown 56%,
;   worst month -35% (March 2020), worst 12 months -35%. Last 3 years, real ticks (run 824): +363%, drawdown 42%,
;   best 12 months +203%, worst 12 months -6%.
; For the same drawdown this earned more than reversion alone at 12.5 (+30% per year, drawdown 56%).
InpEntryMode=8
InpIxRevSymbols=US500,US100,US30,JP225
InpIxTrendSymbols=US100
InpIxRuleR2=true
InpIxRuleD7=true
InpIxRuleIBS=true
InpIxRevUnitVol=8.75
InpIxTrendUnitVol=20.0
InpIxTrendCheckDays=7
InpIxMaxLev=10.0
InpIxBand=0.25
InpIxSLVolMul=4.0
InpIxVolModel=1
InpIxVixFile=AMS_vix.csv
InpIxVixLowMult=0.5
InpIxVixHighMult=1.5
InpIxRuleWeights=1,2,4
InpIxSoGuard=0.9
InpIxFlatMinutes=0
InpIxFlatEdgeBp=0.0
InpIxDelayMin=5
InpIxMaxSpreadPct=0.05
InpMaxMarginUsePct=90.0
InpIxJointRound=false
InpIxJointEps=0.25
InpIxWarmStart=true
InpIxRegimeDays=1500
InpIxRegimeThr=1.0
InpIxRegimeRef=US500
InpIxDryRun=false
InpIxEquityOffset=0
