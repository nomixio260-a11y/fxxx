# このファイルを tester/credentials.env にコピーして、OANDA デモ口座の情報を書く。
# tester/credentials.env は .gitignore で除外されているので、コミットされない。
MT5_LOGIN=12345678
MT5_PASSWORD=your-demo-password
# MT5 のログイン画面に表示されるサーバー名（例: OANDA-Japan MT5 Demo）
MT5_SERVER="OANDA-Japan MT5 Demo"
# 口座で表示される銘柄名（接尾辞がある場合はそれも含める。例: USDJPY.oj1m）
MT5_SYMBOL=USDJPY
